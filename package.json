{
  "name": "viewgram",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Native-SVG diagram navigation and source editing for Obsidian",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node scripts/serve.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:taxonomy && npm run build && npm run test:browser",
    "test:taxonomy": "node scripts/check-taxonomy.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "mermaid": "11.17.2",
    "obsidian": "1.13.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "moment": "2.31.0",
    "katex": "0.18.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevGuyRash/viewgram.git"
  },
  "bugs": {
    "url": "https://github.com/DevGuyRash/viewgram/issues"
  },
  "homepage": "https://github.com/DevGuyRash/viewgram#readme"
}
